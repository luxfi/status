{
  "name": "lux-status",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "routes": [
    { "pattern": "luxstat.us", "custom_domain": true },
    { "pattern": "status.lux.network", "custom_domain": true }
  ]
}
